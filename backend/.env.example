# ==============================================================================
# Tikakaran Register – HMIS Reminder Software (Backend Environment Variables)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String for Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# NOTE: If your password contains special characters like '@', '#', or '%',
# they must be URL-encoded (e.g. '@' becomes '%40', '#' becomes '%23').
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/tikakaran_hmis?schema=public"

# JWT Authentication Secrets
# Generate a cryptographically secure key (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace_with_a_secure_random_secret_key_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"

# Allowed Cross-Origin Resource Sharing (CORS) Origin
CORS_ORIGIN="http://localhost:3000"

